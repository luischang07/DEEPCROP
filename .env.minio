# Configuración MinIO para almacenamiento de imágenes
MINIO_ACCESS_KEY=deepcrop_minio_user
MINIO_SECRET_KEY=deepcrop_minio_password123
MINIO_REGION=us-east-1
MINIO_BUCKET=deepcrop-images
MINIO_ENDPOINT=http://localhost:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true
MINIO_URL=http://localhost:9000

# Configuración opcional para tamaño máximo de archivos (en bytes)
# 500MB = 524288000 bytes
FILESYSTEMS_MAX_IMAGE_SIZE=524288000